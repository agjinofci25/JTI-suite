# Copy this file to .env and fill it in. Never commit .env.

# Test environment URL. The suite refuses to run unless the host contains a test label
# such as "staging" or "development" (protection against running against production).
BASE_URL=https://staging.example.com

# Production host (required) – the suite refuses to run against it, and tests fail if
# any request goes there.
PROD_HOST=example.com

# --- Codes that are NOT consumed by the tests -----------------------------
# An unused (or unfinished) code. The first test redeems it; redeeming it again resumes
# the entry, so the contact-form tests can reuse it. Unfinished entries lapse 24 h after
# the first redeem – put in a new code then.
CODE_RESUMABLE_NO_WIN=

# A code that is already fully used (should return 409 "already used").
CODE_USED=

# --- Codes that ARE consumed (full-flow tests only) -----------------------
# Each value can be used once. Put fresh codes here before every full-flow run.
CODE_FRESH_WIN=
CODE_FRESH_NO_WIN=

# Full-flow tests submit the contact form and send a real verification email.
RUN_CONSUMING_TESTS=false
TEST_EMAIL=test+e2e@example.com
TEST_FIRST_NAME=Test
TEST_LAST_NAME=Automation
TEST_PLZ=1030
