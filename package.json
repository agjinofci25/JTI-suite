{
  "name": "campaign-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript E2E tests for a code-redeem sweepstakes page",
  "scripts": {
    "test": "playwright test",
    "test:regression": "playwright test --grep-invert \"@known-bug|@consumes-code\"",
    "test:known-bugs": "playwright test --grep @known-bug",
    "test:full-flow": "cross-env RUN_CONSUMING_TESTS=true playwright test --grep @consumes-code --project=desktop",
    "test:desktop": "playwright test --project=desktop",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
